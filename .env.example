# Copy to .env.local and fill in. Without these the site runs in DEMO MODE on sample data.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site (used for metadata / OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Later — real payment / shipping integrations (currently simulated in the admin)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
